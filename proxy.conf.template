# =============================================================================
# proxy.conf.template — API reverse proxy location (server context)
#
# This template is processed by envsubst at container startup ONLY when
# BACKEND_HOST is set. The result is written to:
#   /etc/nginx/conf.d/proxy-backend.conf
#
# It is included by the glob directive in the server block of nginx.conf:
#   include /etc/nginx/conf.d/proxy-*.conf;
#
# When BACKEND_HOST is NOT set, this template is ignored and the glob
# matches zero files — nginx operates in static-only mode.
#
# proxy_pass has NO trailing URI — the original request path is forwarded
# as-is (e.g. /api/users/123 → backend:8080/api/users/123).
#
# Security headers are repeated here because this location defines its own
# add_header directives, which breaks inheritance from the server block.
# =============================================================================
location /api/ {
    proxy_pass http://backend;
    proxy_http_version 1.1;

    # Forward client information to the backend
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host  $host;

    # WebSocket support (Upgrade headers are no-ops for plain HTTP)
    proxy_set_header Upgrade    $http_upgrade;
    proxy_set_header Connection $connection_upgrade;

    # Timeouts
    proxy_connect_timeout 60s;
    proxy_send_timeout    60s;
    proxy_read_timeout    60s;

    # Buffering
    proxy_buffering   on;
    proxy_buffer_size 4k;
    proxy_buffers     8 4k;

    # Security headers (repeated — required because add_header below
    # breaks inheritance from the server block)
    add_header X-Frame-Options        "SAMEORIGIN"                      always;
    add_header X-Content-Type-Options "nosniff"                         always;
    add_header X-XSS-Protection       "1; mode=block"                  always;
    add_header Referrer-Policy        "strict-origin-when-cross-origin" always;
}
